{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "naught",
  "compatibility_date": "2026-09-22",
  // Static site: every unknown path gets index.html so the client router owns the URL.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "naught.lbert.io",
      "custom_domain": true,
      // `wrangler preview` (what Workers Builds runs for non-production branches)
      // serves each branch at <branch>.naught.lbert.io. Cloudflare creates the
      // wildcard DNS record and certificate. A stable origin per branch means
      // browser storage (file handle, SimpleFIN credentials, theme) survives
      // new pushes to the same PR.
      "previews_enabled": true
    }
  ]
}
